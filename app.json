    "android": {
      "package": "com.profolio.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0B0F"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}